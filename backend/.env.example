# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and customize values for your environment.
# All variables have safe defaults for local development — you only need
# to change them when deploying to production.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev — zero config, just works):
DATABASE_URL=sqlite:///./test.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://laetus_user:your_secure_password@localhost:5432/laetus_db
#
# To migrate from SQLite to PostgreSQL:
#   1. Set DATABASE_URL to your PostgreSQL connection string above
#   2. Run: python -m alembic upgrade head
#   3. Run: python scripts/migrate_sqlite_to_pg.py

# ─── JWT & Security ──────────────────────────────────────────────────────────
# REQUIRED — generate a strong random key and paste it here.
# Example:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app will NOT start without a valid SECRET_KEY.
SECRET_KEY=CHANGE-ME-generate-a-strong-random-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local:       http://localhost:5173,http://127.0.0.1:5173
# Production:  https://laetus.io.vn
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Backend Public URL ──────────────────────────────────────────────────────
# NOTE: Media file URLs (posters, HLS playlists) are now root-relative
# (e.g. /media/videos/hls/…) and served via Nginx proxy, so BACKEND_URL
# is no longer used for media URL generation.
# Keep this variable if other integrations reference it.
# Local:       http://localhost:8000
# Production:  https://laetus.io.vn
BACKEND_URL=http://localhost:8000

# ─── Frontend URL ────────────────────────────────────────────────────────────
# Used in email templates (password reset links, welcome emails,
# password change confirmation links).
# ⚠️  This MUST match the actual domain users access in the browser.
# Local:       http://localhost:5173
# Production:  https://laetus.io.vn
FRONTEND_URL=http://localhost:5173

# ─── SMTP (Email) ────────────────────────────────────────────────────────────
# Gmail SMTP (SSL on port 465). Set SMTP_PASSWORD to your Gmail App Password.
# Leave SMTP_PASSWORD empty to use console-log fallback (no real emails sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply.tltn@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Laetus
SMTP_FROM_EMAIL=noreply.tltn@gmail.com

# ─── Password Reset ──────────────────────────────────────────────────────────
# How many minutes a password-reset token stays valid.
# Default: 60 (1 hour).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ─── Recommendation Engine ───────────────────────────────────────────────────
# When true (default), the AI recommendation engine only considers movies
# with uploaded video (video_source_path, hls_playlist_path, or
# processing_status="ready") as recommendation candidates.
# Set to false to include all movies in the catalog regardless of video status.
# For production demos, keep this true so the AI only recommends movies
# that users can actually watch on the website.
RECOMMEND_ONLY_UPLOADED_MOVIES=true
